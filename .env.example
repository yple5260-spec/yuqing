# Connection secret: use platform-injected TYAPP_DATABASE_URL in deployment.
TYAPP_DATABASE_URL=
# All six values from the platform; blank together selects legacy local media.
TYAPP_S3_ENDPOINT=
TYAPP_S3_REGION=
TYAPP_S3_BUCKET=
TYAPP_S3_ACCESS_KEY_ID=
TYAPP_S3_SECRET_ACCESS_KEY=
TYAPP_S3_FORCE_PATH_STYLE=
XIN_DATA_DIR=/data
XIN_HOST=0.0.0.0
XIN_PORT=8765
XIN_SECURE_COOKIE=1
XIN_REQUIRE_POSTGRES=1
# Exact public hostnames from application details; keep localhost for health checks.
XIN_ALLOWED_HOSTS=127.0.0.1,localhost,oneview.jiarui.net.cn
# Replace with confirmed platform proxy CIDRs; do not use 0.0.0.0/0.
XIN_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
# Runtime Secret. When migrating, MUST be the original SQLite encryption key.
XIN_ENCRYPTION_KEY=
# ONEVIEW_APP_SLUG is injected by the platform; do not override reserved variables.
