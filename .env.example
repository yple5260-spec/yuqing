# Connection secret: use platform-injected TYAPP_DATABASE_URL in deployment.
TYAPP_DATABASE_URL=
# All six values from the platform; blank together selects legacy local media.
TYAPP_S3_ENDPOINT=
TYAPP_S3_REGION=
TYAPP_S3_BUCKET=
TYAPP_S3_ACCESS_KEY_ID=
TYAPP_S3_SECRET_ACCESS_KEY=
TYAPP_S3_FORCE_PATH_STYLE=
XIN_DATA_DIR=/data
XIN_HOST=0.0.0.0
XIN_PORT=8765
XIN_SECURE_COOKIE=1
XIN_REQUIRE_POSTGRES=1
# Exact public hostnames from application details; keep localhost for health checks.
XIN_ALLOWED_HOSTS=127.0.0.1,localhost,oneview.jiarui.net.cn
# Replace with confirmed platform proxy CIDRs; do not use 0.0.0.0/0.
XIN_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
# Runtime Secret. When migrating, MUST be the original SQLite encryption key.
XIN_ENCRYPTION_KEY=
# Optional local Python executable with requirements-crawler.txt installed.
# Blank uses runtime/crawl4ai-venv. The Tianyan image sets /opt/crawler/bin/python.
XIN_CRAWLER_PYTHON=
# direct (default), juliang, openwrt, or custom. No automatic route failover.
XIN_CRAWLER_PROXY=direct
# juliang: fixed HTTP tunnel with per-request exit rotation managed by provider.
juliang_proxy_host=
juliang_proxy_port=
juliang_proxy_user=
juliang_proxy_pass=
# openwrt: prefer full HTTP URL; Chromium cannot authenticate a SOCKS5 proxy.
op_proxy_url_http=
op_proxy_url_socks5=
# custom: explicit server URL and optional username/password.
XIN_CRAWLER_PROXY_SERVER=
XIN_CRAWLER_PROXY_USERNAME=
XIN_CRAWLER_PROXY_PASSWORD=
# ONEVIEW_APP_SLUG is injected by the platform; do not override reserved variables.
